{
  "name": "tenstorrent-skills",
  "interface": {
    "displayName": "Tenstorrent Skills"
  },
  "plugins": [
    {
      "name": "tt-skills",
      "source": {
        "source": "local",
        "path": "./plugins/tt-skills"
      },
      "policy": {
        "installation": "INSTALLED_BY_DEFAULT",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "tt-review-skills",
      "source": {
        "source": "local",
        "path": "./plugins/tt-review-skills"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "tt-autodebug",
      "source": {
        "source": "local",
        "path": "./plugins/tt-autodebug"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "tt-model-bringup",
      "source": {
        "source": "local",
        "path": "./plugins/tt-model-bringup"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools",
      "description": "Staged TTNN model bring-up with vLLM TT plugin serving; requires tt-autodebug. Codex runs add optional telemetry when tenstorrent/ar-dashboard is accessible."
    },
    {
      "name": "tt-train-bringup",
      "source": {
        "source": "local",
        "path": "./plugins/tt-train-bringup"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools",
      "description": "Staged tt-train training bring-up on the plan's chips: plan, composite bring-up with first-baseline checks and recipe-correct MFU, then optimisation with gradient PCC and Tracy gates; requires tt-autodebug."
    },
    {
      "name": "tt-debug-tools",
      "source": {
        "source": "local",
        "path": "./plugins/tt-debug-tools"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "tt-buddy",
      "source": {
        "source": "local",
        "path": "./plugins/tt-buddy"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    }
  ]
}
