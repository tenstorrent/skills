{
  "name": "tenstorrent-skills",
  "interface": {
    "displayName": "Tenstorrent Skills"
  },
  "plugins": [
    {
      "name": "tt-skills",
      "source": {
        "source": "local",
        "path": "./plugins/tt-skills"
      },
      "policy": {
        "installation": "INSTALLED_BY_DEFAULT",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "tt-review-skills",
      "source": {
        "source": "local",
        "path": "./plugins/tt-review-skills"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "tt-autodebug",
      "source": {
        "source": "local",
        "path": "./plugins/tt-autodebug"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "tt-model-bringup",
      "source": {
        "source": "local",
        "path": "./plugins/tt-model-bringup"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools",
      "description": "Staged TTNN model bring-up with vLLM TT plugin serving; requires tt-autodebug. Codex runs add optional telemetry when tenstorrent/ar-dashboard is accessible."
    },
    {
      "name": "tt-debug-tools",
      "source": {
        "source": "local",
        "path": "./plugins/tt-debug-tools"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "tt-buddy",
      "source": {
        "source": "local",
        "path": "./plugins/tt-buddy"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "tt-serve-model",
      "source": {
        "source": "local",
        "path": "./plugins/tt-serve-model"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools",
      "description": "Diagnose a model launch and verify a running server on Tenstorrent hardware, deterministically and evidence-based."
    },
    {
      "name": "tt-dit-bringup",
      "source": {
        "source": "local",
        "path": "./plugins/tt-dit-bringup"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools",
      "description": "tt_dit model bring-up (diffusion transformers, VAEs, text encoders): correctness, profiling, optimization and a campaign loop, with local, batch, or Slurm device runs."
    }
  ]
}
