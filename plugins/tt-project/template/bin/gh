#!/bin/sh
# Run as sh first: exec the interpreter the daemon named (TTP_PYTHON), else python3 from PATH.
# Python reads the next line as a string.
''''[ -x "${TTP_PYTHON:-}" ] || TTP_PYTHON=python3; exec "$TTP_PYTHON" "$0" "$@" # '''
