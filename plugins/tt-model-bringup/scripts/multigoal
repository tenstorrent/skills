#!/usr/bin/env python3
"""Run a sequence of Codex goals through app-server."""

from __future__ import annotations

import argparse
import functools
import inspect
import datetime as dt
import json
import os
import pathlib
import queue
import re
import shlex
import subprocess
import sys
import threading
import time
import uuid
from dataclasses import dataclass, field
from typing import Any, Callable

# Load sibling support when imported by host-side tests as well as executed.
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from environment import ROOT, DEPENDENCY_SKILLS, dependency_root, environment
from telemetry_hooks import load_telemetry


MAX_GOAL_OBJECTIVE_CHARS = 4_000
TERMINAL_GOAL_STATUSES = {"complete", "blocked", "usageLimited", "budgetLimited"}
SKILL_RE = re.compile(r"\$([A-Za-z0-9][A-Za-z0-9_-]*)")
ENV_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
SHELL_PROFILE_CONFIG = "shell_environment_policy.experimental_use_profile"
DEFAULT_SHELL_PROFILE_CONFIG = f"{SHELL_PROFILE_CONFIG}=false"

# Stage check scripts exit with: 0 = pass, 1 = advisory failure (recorded,
# pipeline continues), 2 = critical failure (after remediation attempts are
# exhausted, no further stages are launched). Any other exit (including the
# checker-internal-error convention of 3) is a broken check or misconfigured
# environment: it is retried once for transients and then, by default, stops
# the pipeline as a runner/infra failure. A silently disabled guardrail would
# bypass the evidence gate. Use --check-error-policy continue to override in an
# emergency.
CHECK_PASS = 0
CHECK_ADVISORY = 1
CHECK_CRITICAL = 2

# Stop classification for automatic recovery. A "transient" stop is an API or
# transport fault (overloaded model, stream disconnect, HTTP 5xx) that says
# nothing about the stage's work, so the runner resumes the same thread after a
# backoff instead of leaving the goal blocked. A "usage" stop is an account
# usage/budget limit with a reset time.
TRANSIENT_ERROR_CODES = {
    "serveroverloaded",
    "internalservererror",
    "responsestreamdisconnected",
    "responsestreamconnectionfailed",
    "responsetoomanyfailedattempts",
    "httpconnectionfailed",
    "streamdisconnected",
}
USAGE_ERROR_CODES = {"usagelimitexceeded", "budgetlimitexceeded", "usagelimitreached"}
USAGE_GOAL_STATUSES = {"usageLimited", "budgetLimited"}
TRANSIENT_MESSAGE_RE = re.compile(
    r"at capacity|overloaded|stream disconnected|disconnected before completion|"
    r"temporarily unavailable|service unavailable|bad gateway|gateway time-?out|"
    r"internal server error|connection (?:reset|refused|closed)|\b50[0-9]\b|\b52[0-9]\b",
    re.IGNORECASE,
)
USAGE_MESSAGE_RE = re.compile(r"usage limit|purchase more credits|spend(?:ing)? (?:cap|limit)", re.IGNORECASE)
TRY_AGAIN_RE = re.compile(
    r"try again at ([A-Z][a-z]{2})[a-z]* (\d{1,2})(?:st|nd|rd|th)?,? (\d{4}),? (\d{1,2}:\d{2}) ?([AP]M)",
    re.IGNORECASE,
)
# Seconds to keep reading after a goal reaches a non-complete terminal status,
# so the turn's own error (which explains *why*) is captured for classification.
TERMINAL_DRAIN_SECONDS = 20.0
RATE_LIMIT_READ_TIMEOUT = 30.0
# Seconds to wait for turn/started after turn/start before giving up.
TURN_START_TIMEOUT = 300.0
# Seconds to wait for a thread's running turn(s) to finish before a new turn
# (remediation report, owner message, recovery text) is sent into that thread.
ACTIVE_TURN_DRAIN_SECONDS = 1800.0
# One headroom pause before a stage never exceeds this.
HEADROOM_MAX_PAUSE_SECONDS = 6 * 3600.0
# Usage-limit resumes allowed when no reset time is known.
MAX_UNKNOWN_RESET_RESUMES = 3
# Turns still running when this process last stopped reading a thread, so a
# later turn into the same live thread can wait for them first.
LIVE_ACTIVE_TURNS: dict[str, set[str]] = {}


class ReadTimeout(Exception):
    """No app-server message arrived before the requested timeout."""


def _sleep(seconds: float) -> None:
    # Indirection so tests can replace waiting without patching time.sleep.
    time.sleep(seconds)


JsonObject = dict[str, Any]


def with_shell_profile_default(config_overrides: list[str]) -> list[str]:
    """Keep agent command shells in the environment inherited by app-server."""
    if any(item.partition("=")[0].strip() == SHELL_PROFILE_CONFIG for item in config_overrides):
        return config_overrides
    return [DEFAULT_SHELL_PROFILE_CONFIG, *config_overrides]


@dataclass
class StageState:
    thread_id: str
    objective: str
    status: str = "active"
    terminal_status: str | None = None
    active_turns: set[str] = field(default_factory=set)
    seen_turns: set[str] = field(default_factory=set)
    last_turn_status: str | None = None
    last_turn_error: str | None = None
    ignore_stale_goal_objective: bool = False
    stale_goal_objective_ignored: bool = False


class AppServerClient:
    def __init__(
        self,
        codex_bin: str,
        repo: pathlib.Path,
        env: dict[str, str],
        stderr_log: pathlib.Path,
        config_overrides: list[str],
    ) -> None:
        self.codex_bin = codex_bin
        self.repo = repo
        self.env = env
        self.stderr_log = stderr_log
        self.config_overrides = config_overrides
        self.proc: subprocess.Popen[str] | None = None
        self._write_lock = threading.Lock()
        self._stderr_tail: list[str] = []
        self._stderr_thread: threading.Thread | None = None
        self._stdout_queue: queue.Queue[str | None] = queue.Queue()
        self._stdout_thread: threading.Thread | None = None
        self.latest_rate_limits: JsonObject | None = None
        self.loaded_threads: set[str] = set()

    def __enter__(self) -> AppServerClient:
        args = [self.codex_bin]
        for item in self.config_overrides:
            args.extend(["--config", item])
        args.extend(["app-server", "--enable", "goals", "--listen", "stdio://"])
        self.proc = subprocess.Popen(
            args,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            cwd=self.repo,
            env=self.env,
            bufsize=1,
        )
        self._start_stderr_drain_thread()
        self._start_stdout_reader_thread()
        return self

    def __exit__(self, _exc_type: object, _exc: object, _tb: object) -> None:
        if self.proc is None:
            return
        proc = self.proc
        self.proc = None
        if proc.stdin:
            proc.stdin.close()
        try:
            proc.terminate()
            proc.wait(timeout=2)
        except Exception:
            proc.kill()
        if self._stderr_thread and self._stderr_thread.is_alive():
            self._stderr_thread.join(timeout=0.5)

    def request(
        self,
        method: str,
        params: JsonObject | None,
        log: Any,
        on_event: Callable[[JsonObject], None] | None = None,
        timeout: float | None = None,
    ) -> JsonObject:
        request_id = str(uuid.uuid4())
        payload: JsonObject = {"id": request_id, "method": method}
        if params is not None:
            payload["params"] = params
        self._send(payload, log)

        deadline = None if timeout is None else time.monotonic() + timeout
        while True:
            remaining = None if deadline is None else max(0.0, deadline - time.monotonic())
            message = self._read(log, timeout=remaining)
            if message.get("id") == request_id and "error" in message:
                raise RuntimeError(f"{method} failed: {message['error']}")
            if message.get("id") == request_id:
                result = message.get("result", {})
                if not isinstance(result, dict):
                    raise RuntimeError(f"{method} returned non-object result: {result!r}")
                return result
            self._handle_non_response(message, log, on_event)

    def read_event(
        self,
        log: Any,
        on_event: Callable[[JsonObject], None] | None = None,
        timeout: float | None = None,
    ) -> JsonObject:
        deadline = None if timeout is None else time.monotonic() + timeout
        while True:
            remaining = None if deadline is None else max(0.0, deadline - time.monotonic())
            message = self._read(log, timeout=remaining)
            if "id" in message and "method" in message:
                self._handle_server_request(message, log)
                continue
            if "method" in message:
                if on_event is not None:
                    on_event(message)
                return message
            if "error" in message:
                raise RuntimeError(f"Unexpected app-server error response: {message['error']}")

    def _handle_non_response(
        self,
        message: JsonObject,
        log: Any,
        on_event: Callable[[JsonObject], None] | None,
    ) -> None:
        if "id" in message and "method" in message:
            self._handle_server_request(message, log)
        elif "method" in message and on_event is not None:
            on_event(message)

    def _handle_server_request(self, message: JsonObject, log: Any) -> None:
        method = message.get("method")
        params = message.get("params")
        result: JsonObject = {}
        if method in {"item/commandExecution/requestApproval", "item/fileChange/requestApproval"}:
            result = {"decision": "accept"}
        elif method == "item/permissions/requestApproval" and isinstance(params, dict):
            result = {"permissions": params.get("permissions", {}), "scope": "session"}
        self._send({"id": message["id"], "result": result}, log)

    def _send(self, payload: JsonObject, log: Any) -> None:
        self._log(log, "send", payload)
        if self.proc is None or self.proc.stdin is None:
            raise RuntimeError("app-server process is not running")
        with self._write_lock:
            self.proc.stdin.write(json.dumps(payload) + "\n")
            self.proc.stdin.flush()

    def _read(self, log: Any, timeout: float | None = None) -> JsonObject:
        if self.proc is None or self.proc.stdout is None:
            raise RuntimeError("app-server process is not running")
        try:
            line = self._stdout_queue.get(timeout=timeout)
        except queue.Empty as exc:
            raise ReadTimeout() from exc
        if not line:
            # Keep end-of-stream visible to later reads.
            self._stdout_queue.put(None)
            tail = "\n".join(self._stderr_tail[-40:])
            raise RuntimeError(f"app-server closed stdout; stderr tail:\n{tail}")
        try:
            message = json.loads(line)
        except json.JSONDecodeError as exc:
            raise RuntimeError(f"Invalid app-server JSON line: {line!r}") from exc
        if not isinstance(message, dict):
            raise RuntimeError(f"Invalid app-server JSON payload: {message!r}")
        self._log(log, "recv", message)
        if message.get("method") == "account/rateLimits/updated":
            params = message.get("params")
            if isinstance(params, dict) and isinstance(params.get("rateLimits"), dict):
                self.latest_rate_limits = params["rateLimits"]
        return message

    def _log(self, log: Any, direction: str, payload: JsonObject) -> None:
        log.write(json.dumps({"ts": timestamp(), "direction": direction, "message": payload}) + "\n")
        log.flush()

    def _start_stderr_drain_thread(self) -> None:
        if self.proc is None or self.proc.stderr is None:
            return

        def drain() -> None:
            assert self.proc is not None
            assert self.proc.stderr is not None
            with self.stderr_log.open("a", encoding="utf-8") as stderr:
                for line in self.proc.stderr:
                    line = line.rstrip("\n")
                    self._stderr_tail.append(line)
                    del self._stderr_tail[:-80]
                    stderr.write(line + "\n")
                    stderr.flush()

        self._stderr_thread = threading.Thread(target=drain, daemon=True)
        self._stderr_thread.start()

    def _start_stdout_reader_thread(self) -> None:
        # A reader thread lets callers wait for events with a timeout.
        if self.proc is None or self.proc.stdout is None:
            return
        stdout = self.proc.stdout

        def reader() -> None:
            try:
                for line in stdout:
                    self._stdout_queue.put(line)
            except (OSError, ValueError):
                pass
            self._stdout_queue.put(None)

        self._stdout_thread = threading.Thread(target=reader, daemon=True)
        self._stdout_thread.start()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Run each prompt file as an exact persisted Codex goal through "
            "codex app-server. This runner requires the openai-codex Python "
            "package unless --codex-bin points at a Codex binary explicitly."
        )
    )
    parser.add_argument("prompt_files", nargs="+", type=pathlib.Path)
    parser.add_argument("--repo", type=pathlib.Path, default=pathlib.Path.cwd())
    parser.add_argument("--codex-home", type=pathlib.Path)
    parser.add_argument(
        "--codex-bin",
        default=os.environ.get("CODEX_BIN"),
        help="Codex binary for app-server. Default: bundled binary from openai-codex.",
    )
    parser.add_argument(
        "--log-dir",
        type=pathlib.Path,
        default=None,
        help=(
            "Exact run directory. Default: $RUN_MULTIGOAL_LOG_DIR/<UTC timestamp> "
            "or <repo>/bringup/artifacts/multigoal-runs/<UTC timestamp>."
        ),
    )
    parser.add_argument(
        "--replace",
        action="append",
        default=[],
        metavar="OLD=NEW",
        help="Literal text replacement applied to every prompt before sending.",
    )
    parser.add_argument(
        "--start-index",
        type=int,
        default=1,
        help="Stage number to use for the first prompt file, useful when continuing from a later stage.",
    )
    parser.add_argument(
        "--resume-stage",
        type=int,
        default=None,
        help=(
            "Resume an existing terminal stage from --log-dir/manifest.txt using "
            "its recorded stage_N_thread_id, then continue later stages. This is "
            "for usageLimited/budgetLimited/blocker recovery where --start-index "
            "would lose the stopped thread's context."
        ),
    )
    parser.add_argument(
        "--config",
        action="append",
        default=[],
        metavar="KEY=VALUE",
        help=(
            "Codex config override passed to app-server. May be repeated. "
            "Shell profile initialization defaults to false."
        ),
    )
    parser.add_argument(
        "--check-retries",
        type=int,
        default=1,
        help=(
            "Remediation goals to run when a stage's <prompt>.check.sh fails "
            "before recording the failure (default: 1)."
        ),
    )
    parser.add_argument(
        "--no-checks",
        action="store_true",
        help="Skip <prompt>.check.sh verification scripts entirely.",
    )
    parser.add_argument(
        "--check-error-policy",
        choices=("stop", "continue"),
        default="stop",
        help=(
            "What to do when a check script itself is broken (exit outside "
            "0/1/2 after one retry). Default: stop the pipeline as an infra "
            "failure so a disabled guardrail cannot pass silently."
        ),
    )
    parser.add_argument(
        "--remediate-advisory",
        action="store_true",
        help=(
            "Also start a remediation goal when a check exits 1 (advisory). "
            "Default: advisory results are recorded and the pipeline continues."
        ),
    )
    parser.add_argument(
        "--remediation-thread",
        choices=("same", "new"),
        default="new",
        help=(
            "Where remediation runs. 'new' (default) starts a fresh thread with a "
            "remediation goal. 'same' (opt-in) continues the stage's own thread with "
            "the check report as the next turn so the agent keeps its context; it "
            "falls back to a new thread if the stage thread cannot take a new turn."
        ),
    )
    parser.add_argument(
        "--message-file",
        type=pathlib.Path,
        help=(
            "With --resume-stage: send this file's text as the resume turn in the "
            "recorded thread instead of the generic continue message (owner steering)."
        ),
    )
    parser.add_argument(
        "--transient-retries",
        type=int,
        default=3,
        help=(
            "Automatic same-thread resumes after a transient API error "
            "(model at capacity, stream disconnect, HTTP 5xx). Default: 3."
        ),
    )
    parser.add_argument(
        "--transient-backoff",
        default="300,900,2700",
        help="Comma-separated seconds to wait before each transient resume (last value repeats).",
    )
    parser.add_argument(
        "--wait-on-usage-limit",
        action="store_true",
        help=(
            "On usageLimited/budgetLimited, sleep until the reported reset time "
            "and resume the same thread instead of stopping."
        ),
    )
    parser.add_argument(
        "--max-usage-wait-hours",
        type=float,
        default=168.0,
        help="Upper bound on total usage-limit waiting per run (default: 168 h).",
    )
    parser.add_argument(
        "--usage-poll-seconds",
        type=int,
        default=1800,
        help="Retry interval when a usage limit reports no reset time (default: 1800 s).",
    )
    parser.add_argument(
        "--min-headroom-pct",
        type=float,
        default=15.0,
        help=(
            "Before each stage, if a fresh account/rateLimits/read reports less than this "
            "percent left in the primary (short) window, pause until its reset (at most "
            "6 h) instead of starting a stage that would be cut mid-way. The secondary "
            "(weekly) window counts only with --wait-on-usage-limit. 0 disables. "
            "Skipped when the read fails."
        ),
    )
    parser.add_argument(
        "--notify-cmd",
        help=(
            "Shell command run (fire and forget) when a stage stops blocked, turnFailed, "
            "usage-limited, critical-fail or check-error, and when the run finishes. "
            "Environment: STAGE, STATUS, LOG_DIR, MESSAGE."
        ),
    )
    parser.add_argument(
        "--notify-timeout",
        type=int,
        default=60,
        help="Seconds before a --notify-cmd process is killed (default: 60).",
    )
    parser.add_argument("--approval-policy", default="never")
    parser.add_argument("--sandbox", default="danger-full-access")
    parser.add_argument("--model")
    parser.add_argument("--effort")
    parser.add_argument("--summary")
    parser.add_argument("--service-tier")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--telemetry-plugin", type=pathlib.Path,
                        default=os.environ.get("TT_BRINGUP_TELEMETRY_ROOT") or None,
                        help="Explicit optional telemetry plugin root; disabled when unset.")
    args = parser.parse_args()
    args.config = with_shell_profile_default(args.config)
    if args.start_index < 1:
        raise SystemExit("--start-index must be >= 1")
    if args.resume_stage is not None and args.resume_stage < 1:
        raise SystemExit("--resume-stage must be >= 1")
    if args.resume_stage is not None and args.log_dir is None:
        raise SystemExit("--resume-stage requires --log-dir pointing at the existing multigoal log directory")
    if args.message_file is not None:
        if args.resume_stage is None:
            raise SystemExit("--message-file requires --resume-stage")
        if not args.message_file.is_file():
            raise SystemExit(f"--message-file not found: {args.message_file}")
        if not args.message_file.read_text(encoding="utf-8").strip():
            raise SystemExit(f"--message-file is empty: {args.message_file}")
    if args.transient_retries < 0:
        raise SystemExit("--transient-retries must be >= 0")
    args.transient_backoff_seconds = parse_backoff(args.transient_backoff)
    if args.min_headroom_pct < 0 or args.min_headroom_pct > 100:
        raise SystemExit("--min-headroom-pct must be between 0 and 100")
    return args


def parse_backoff(value: str) -> list[int]:
    try:
        delays = [int(item.strip()) for item in value.split(",") if item.strip()]
    except ValueError as exc:
        raise SystemExit(f"--transient-backoff expects comma-separated seconds, got: {value}") from exc
    if not delays or any(delay < 0 for delay in delays):
        raise SystemExit(f"--transient-backoff expects non-negative seconds, got: {value}")
    return delays


def timestamp() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def parse_replacements(items: list[str]) -> list[tuple[str, str]]:
    replacements: list[tuple[str, str]] = []
    for item in items:
        if "=" not in item:
            raise SystemExit(f"--replace expects OLD=NEW, got: {item}")
        old, new = item.split("=", 1)
        if not old:
            raise SystemExit("--replace OLD cannot be empty")
        replacements.append((old, new))
    return replacements


def replacement_value(replacements: list[tuple[str, str]], name: str) -> str | None:
    value: str | None = None
    for old, new in replacements:
        if old == name:
            value = new
    return value


def load_prompt(path: pathlib.Path, replacements: list[tuple[str, str]]) -> str:
    text = path.read_text()
    for old, new in replacements:
        text = text.replace(old, new)
    if not text.lstrip().startswith("/goal"):
        raise SystemExit(f"{path} must start with a /goal command")
    return text.rstrip() + "\n"


def objective_from_prompt(prompt: str) -> str:
    text = prompt.lstrip()
    if not text.startswith("/goal"):
        raise SystemExit("prompt must start with /goal")
    objective = text[len("/goal") :].strip()
    if not objective:
        raise SystemExit("goal objective must not be empty")
    chars = len(objective)
    if chars > MAX_GOAL_OBJECTIVE_CHARS:
        raise SystemExit(
            f"goal objective is {chars} characters; Codex app-server limit is "
            f"{MAX_GOAL_OBJECTIVE_CHARS}. Put long details in a prompt file and "
            "make the objective point at that file."
        )
    return objective


def parse_skill_names(text: str) -> list[str]:
    return sorted(set(SKILL_RE.findall(text)))


def skill_path(repo: pathlib.Path, name: str) -> pathlib.Path | None:
    candidates = [ROOT / "skills" / name / "SKILL.md"]
    if name in DEPENDENCY_SKILLS:
        candidates = [dependency_root() / "skills" / name / "SKILL.md"]
    for path in candidates:
        if path.exists():
            return path
    return None


def qualified_skill_name(name: str) -> str:
    plugin = "tt-autodebug" if name in DEPENDENCY_SKILLS else "tt-model-bringup"
    return f"{plugin}:{name}"


def verify_enabled_installations(result: JsonObject) -> None:
    """Fail before the first turn if this Codex home cannot select either package."""
    available = {
        (skill.get("name"), str(pathlib.Path(skill["path"]).resolve()))
        for group in result.get("data", [])
        for skill in group.get("skills", [])
        if skill.get("enabled") and skill.get("path")
    }
    expected = list((ROOT / "skills").glob("*/SKILL.md"))
    expected += [dependency_root() / "skills" / name / "SKILL.md" for name in DEPENDENCY_SKILLS]
    for path in expected:
        name = qualified_skill_name(path.parent.name)
        if (name, str(path.resolve())) not in available:
            raise RuntimeError(
                f"Required installed skill is missing or disabled in this Codex home: {name} ({path}). "
                "Enable both plugins and launch their installed paths with the matching --codex-home."
            )


def input_items_for_objective(repo: pathlib.Path, objective: str) -> tuple[list[JsonObject], list[str]]:
    items: list[JsonObject] = [{"type": "text", "text": objective}]
    missing: list[str] = []
    for name in parse_skill_names(objective):
        path = skill_path(repo, name)
        if path is None:
            missing.append(name)
            continue
        items.append({"type": "skill", "name": qualified_skill_name(name), "path": str(path)})
    return items, missing


def input_items_for_resume(
    repo: pathlib.Path, message: str, original_objective: str
) -> tuple[list[JsonObject], list[str]]:
    items: list[JsonObject] = [{"type": "text", "text": message}]
    missing: list[str] = []
    for name in parse_skill_names(original_objective):
        path = skill_path(repo, name)
        if path is None:
            missing.append(name)
            continue
        items.append({"type": "skill", "name": qualified_skill_name(name), "path": str(path)})
    return items, missing


def codex_home(env: dict[str, str], explicit: pathlib.Path | None) -> pathlib.Path:
    # Unattended bringup runs use ChatGPT auth in CODEX_HOME. Do not let
    # an ambient API key silently switch the billing/auth path.
    env.pop("OPENAI_API_KEY", None)
    env.pop("CODEX_API_KEY", None)
    if explicit is not None:
        home = explicit.expanduser()
        env["CODEX_HOME"] = str(home)
        return home
    return pathlib.Path(env.get("CODEX_HOME", "~/.codex")).expanduser()


def resolve_codex_bin(explicit: str | None) -> str:
    if explicit:
        return explicit
    try:
        from codex_cli_bin import bundled_codex_path
    except ImportError as exc:
        raise SystemExit(
            "openai-codex is required for multigoal's app-server runner. "
            "Install the repo-local agent dependencies in the active Python "
            "environment with: python -m pip install -r ${TT_MODEL_BRINGUP_ROOT}/requirements.txt"
        ) from exc
    return str(bundled_codex_path())


def stage_name(index: int, path: pathlib.Path) -> str:
    safe = re.sub(r"[^A-Za-z0-9_.-]+", "-", path.stem).strip("-") or "prompt"
    return f"{index:02d}-{safe}"


def turn_params(args: argparse.Namespace, repo: pathlib.Path) -> JsonObject:
    params: JsonObject = {
        "cwd": str(repo),
        "approvalPolicy": args.approval_policy,
        "sandboxPolicy": {"type": sandbox_policy_type(args.sandbox)},
    }
    if args.model:
        params["model"] = args.model
    if args.effort:
        params["effort"] = args.effort
    if args.summary:
        params["summary"] = args.summary
    if args.service_tier:
        params["serviceTier"] = args.service_tier
    return params


def sandbox_policy_type(value: str) -> str:
    return {
        "danger-full-access": "dangerFullAccess",
        "workspace-write": "workspaceWrite",
        "read-only": "readOnly",
        "external-sandbox": "externalSandbox",
    }.get(value, value)


def thread_start_params(args: argparse.Namespace, repo: pathlib.Path) -> JsonObject:
    params: JsonObject = {
        "cwd": str(repo),
        "approvalPolicy": args.approval_policy,
        "sandbox": args.sandbox,
    }
    if args.model:
        params["model"] = args.model
    if args.service_tier:
        params["serviceTier"] = args.service_tier
    return params


def thread_resume_params(args: argparse.Namespace, repo: pathlib.Path, thread_id: str) -> JsonObject:
    params = thread_start_params(args, repo)
    params["threadId"] = thread_id
    return params


def goal_from_response(result: JsonObject) -> JsonObject:
    goal = result.get("goal")
    if not isinstance(goal, dict):
        raise RuntimeError(f"app-server response did not include a goal object: {result!r}")
    return goal


def in_progress_turn_ids(result: JsonObject) -> list[str]:
    thread = result.get("thread")
    if not isinstance(thread, dict):
        return []
    turns = thread.get("turns")
    if not isinstance(turns, list):
        return []
    ids: list[str] = []
    for turn in turns:
        if not isinstance(turn, dict) or turn.get("status") != "inProgress":
            continue
        turn_id = turn.get("id")
        if isinstance(turn_id, str):
            ids.append(turn_id)
    return ids


def update_stage_state(state: StageState, message: JsonObject) -> None:
    method = message.get("method")
    params = message.get("params")
    if not isinstance(method, str) or not isinstance(params, dict):
        return
    if params.get("threadId") != state.thread_id:
        return

    if method == "turn/started":
        turn = params.get("turn")
        if isinstance(turn, dict) and isinstance(turn.get("id"), str):
            state.active_turns.add(turn["id"])
            state.seen_turns.add(turn["id"])
            # An error from an earlier turn does not explain later stops.
            state.last_turn_error = None
        return

    if method == "turn/completed":
        turn = params.get("turn")
        if isinstance(turn, dict):
            turn_id = turn.get("id")
            if (
                state.ignore_stale_goal_objective
                and isinstance(turn_id, str)
                and turn_id not in state.active_turns
                and turn_id not in state.seen_turns
            ):
                # A resumed state can receive the completion of a turn from the
                # previous attempt; it says nothing about this attempt.
                return
            if isinstance(turn_id, str):
                state.active_turns.discard(turn_id)
            status = turn.get("status")
            if isinstance(status, str):
                state.last_turn_status = status
                if status == "failed":
                    error = turn.get("error")
                    state.last_turn_error = json.dumps(error) if error is not None else "turn failed"
                    state.terminal_status = "turnFailed"
        return

    if method == "error":
        # Non-retried turn errors explain a following failed turn or blocked goal.
        error = params.get("error")
        if error is not None and params.get("willRetry") is False:
            state.last_turn_error = json.dumps(error)
        return

    if method == "thread/goal/updated":
        goal = params.get("goal")
        if not isinstance(goal, dict):
            return
        objective = goal.get("objective")
        if objective != state.objective:
            if state.ignore_stale_goal_objective:
                # Resumed threads can replay an older thread/goal/updated event
                # from the pre-resume objective. Ignore it after the resume path
                # has explicitly reset the live objective.
                if not state.stale_goal_objective_ignored:
                    expected = repr(state.objective[:120])
                    actual = repr(str(objective)[:120])
                    print(
                        "ignored stale resumed goal objective update; "
                        f"expected_prefix={expected} actual_prefix={actual}",
                        file=sys.stderr,
                    )
                    state.stale_goal_objective_ignored = True
                return
            raise RuntimeError(
                "app-server goal objective changed unexpectedly.\n"
                f"Expected: {state.objective!r}\nActual: {objective!r}"
            )
        status = goal.get("status")
        if isinstance(status, str):
            state.status = status
            if status in TERMINAL_GOAL_STATUSES:
                state.terminal_status = status


def wait_for_stage_terminal(client: AppServerClient, log: Any, state: StageState) -> str:
    last_notice = time.monotonic()
    while state.terminal_status is None:
        client.read_event(log, lambda msg: update_stage_state(state, msg))
        now = time.monotonic()
        if now - last_notice > 300:
            print(
                f"stage still active: status={state.status} active_turns={len(state.active_turns)}",
                file=sys.stderr,
            )
            last_notice = now
    terminal = state.terminal_status
    if terminal != "complete" and state.last_turn_error is None:
        drain_turn_error(client, log, state)
    return terminal


def drain_turn_error(client: AppServerClient, log: Any, state: StageState) -> None:
    """Read briefly past a non-complete goal status to capture the turn error.

    The goal can flip to blocked before the turn/completed or error event that
    explains it arrives. Without that error a server_overloaded stop looks like an
    agent-declared blocker. The goal's terminal status is kept unchanged.
    """
    terminal = state.terminal_status
    deadline = time.monotonic() + TERMINAL_DRAIN_SECONDS
    try:
        while state.active_turns:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            client.read_event(log, lambda msg: update_stage_state(state, msg), timeout=remaining)
    except (ReadTimeout, TypeError):
        # TypeError: a client without timeout support; keep the goal status.
        pass
    state.terminal_status = terminal


def wait_for_turn_started(
    client: AppServerClient,
    log: Any,
    state: StageState,
    turn_id: str,
    timeout: float | None = None,
) -> None:
    timeout = TURN_START_TIMEOUT if timeout is None else timeout
    deadline = time.monotonic() + timeout
    while turn_id not in state.active_turns and state.terminal_status is None:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RuntimeError(f"turn {turn_id} did not start within {timeout:.0f}s")
        try:
            client.read_event(log, lambda msg: update_stage_state(state, msg), timeout=remaining)
        except ReadTimeout:
            raise RuntimeError(f"turn {turn_id} did not start within {timeout:.0f}s") from None
    if state.terminal_status is not None:
        raise RuntimeError(f"stage reached terminal status {state.terminal_status} before turn {turn_id} started")


def drain_active_turns(client: AppServerClient, log: Any, state: StageState, timeout: float) -> None:
    """Wait until the thread's running turns finish. RuntimeError on timeout.

    The goal status seen while draining belongs to the old turn, so the caller's
    terminal status is reset afterwards.
    """
    deadline = time.monotonic() + timeout
    while state.active_turns:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        try:
            client.read_event(log, lambda msg: update_stage_state(state, msg), timeout=remaining)
        except ReadTimeout:
            break
    if state.active_turns:
        raise RuntimeError(
            f"thread {state.thread_id} still has running turn(s) {sorted(state.active_turns)} "
            f"after {timeout:.0f}s; the new turn was NOT sent"
        )
    state.terminal_status = None
    state.last_turn_error = None


def remember_active_turns(state: StageState) -> None:
    LIVE_ACTIVE_TURNS[state.thread_id] = set(state.active_turns)


def write_manifest_header(
    path: pathlib.Path,
    repo: pathlib.Path,
    home: pathlib.Path,
    codex_bin: str,
    args: argparse.Namespace,
    replacements: list[tuple[str, str]],
    model_dir: str | None,
) -> None:
    hf_model = replacement_value(replacements, "HF_MODEL")
    path.write_text(
        "\n".join(
            [
                f"started_at_utc={timestamp()}",
                f"repo={repo}",
                f"codex_home={home}",
                f"codex_bin={codex_bin}",
                f"hf_model={hf_model or ''}",
                f"model_dir={model_dir or ''}",
                "runner=app-server",
                f"approval_policy={args.approval_policy}",
                f"sandbox={args.sandbox}",
                "prompt_files:",
                *[f"- {prompt}" for prompt in args.prompt_files],
                "",
            ]
        )
    )


def append_manifest(path: pathlib.Path, lines: list[str]) -> None:
    with path.open("a", encoding="utf-8") as f:
        for line in lines:
            f.write(line + "\n")


def read_manifest(path: pathlib.Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for raw in path.read_text(encoding="utf-8").splitlines():
        if "=" not in raw or raw.startswith("- "):
            continue
        key, value = raw.split("=", 1)
        values[key] = value
    return values


def next_resume_attempt(manifest_values: dict[str, str], index: int) -> int:
    prefix = f"stage_{index}_resume_"
    attempts: list[int] = []
    for key in manifest_values:
        if not key.startswith(prefix):
            continue
        rest = key[len(prefix) :]
        number = rest.split("_", 1)[0]
        if number.isdigit():
            attempts.append(int(number))
    return max(attempts, default=0) + 1


def tracked_goal(function):
    """Report the explicit attempt kind independently of log naming conventions."""
    @functools.wraps(function)
    def run(*positional, **keyword):
        bound = inspect.signature(function).bind(*positional, **keyword)
        bound.apply_defaults()
        values = bound.arguments
        telemetry = getattr(values["args"], "_telemetry", None)
        if telemetry is None:
            return function(*positional, **keyword)
        kind = values["attempt_kind"]
        telemetry.safe_hook("begin_attempt", values["output_log"], kind, values.get("thread_id"))
        if "on_thread_started" in values:
            callback = values.get("on_thread_started")
            def started(thread_id):
                telemetry.safe_hook("thread", thread_id)
                if callback is not None:
                    callback(thread_id)
            values["on_thread_started"] = started
        status = "interrupted"
        try:
            result = function(**values)
            status = result[0]
            return result
        finally:
            telemetry.safe_hook("end_attempt", status)
    return run


def telemetry_input(args, input_items):
    telemetry = getattr(args, "_telemetry", None)
    if telemetry is not None:
        instruction = telemetry.safe_hook("instructions")
        if instruction:
            input_items.append({"type": "text", "text": instruction})


@tracked_goal
def execute_goal(
    client: AppServerClient,
    args: argparse.Namespace,
    repo: pathlib.Path,
    objective: str,
    output_log: pathlib.Path,
    on_thread_started: Callable[[str], None] | None = None,
    *,
    attempt_kind: str = "initial",
) -> tuple[str, str, str | None]:
    """Run one objective to a terminal goal status.

    Returns (terminal_status, thread_id, last_turn_error).
    """
    input_items, _missing = input_items_for_objective(repo, objective)
    telemetry_input(args, input_items)
    with output_log.open("w", encoding="utf-8") as log:
        started = client.request("thread/start", thread_start_params(args, repo), log)
        thread = started.get("thread")
        if not isinstance(thread, dict) or not isinstance(thread.get("id"), str):
            raise RuntimeError(f"thread/start did not return a thread id: {started!r}")
        thread_id = thread["id"]
        loaded = getattr(client, "loaded_threads", None)
        if isinstance(loaded, set):
            loaded.add(thread_id)
        if on_thread_started is not None:
            on_thread_started(thread_id)
        state = StageState(thread_id=thread_id, objective=objective)

        set_paused = client.request(
            "thread/goal/set",
            {"threadId": thread_id, "objective": objective, "status": "paused"},
            log,
            lambda msg: update_stage_state(state, msg),
        )
        paused_goal = goal_from_response(set_paused)
        if paused_goal.get("objective") != objective or paused_goal.get("status") != "paused":
            raise RuntimeError(f"paused goal was not set exactly: {paused_goal!r}")

        turn_payload = turn_params(args, repo)
        turn_payload["input"] = input_items
        turn_payload["threadId"] = thread_id
        turn_started = client.request(
            "turn/start",
            turn_payload,
            log,
            lambda msg: update_stage_state(state, msg),
        )
        turn = turn_started.get("turn")
        turn_id: str | None = None
        if isinstance(turn, dict) and isinstance(turn.get("id"), str):
            turn_id = turn["id"]
            if turn.get("status") == "inProgress":
                state.active_turns.add(turn_id)
        if turn_id is not None:
            wait_for_turn_started(client, log, state, turn_id)

        active_goal = client.request(
            "thread/goal/set",
            {"threadId": thread_id, "status": "active"},
            log,
            lambda msg: update_stage_state(state, msg),
        )
        goal = goal_from_response(active_goal)
        if goal.get("objective") != objective or goal.get("status") != "active":
            raise RuntimeError(f"active goal was not set exactly: {goal!r}")

        terminal = wait_for_stage_terminal(client, log, state)
        remember_active_turns(state)
        return terminal, thread_id, state.last_turn_error


@tracked_goal
def execute_resumed_goal(
    client: AppServerClient,
    args: argparse.Namespace,
    repo: pathlib.Path,
    objective: str,
    thread_id: str,
    output_log: pathlib.Path,
    prompt_copy: pathlib.Path,
    *,
    attempt_kind: str = "resume",
    message: str | None = None,
) -> tuple[str, str | None]:
    """Resume an existing stage thread and run one continuation turn.

    ``message`` replaces the generic continue text (owner steering, automatic
    recovery or a same-thread remediation report). A thread this app-server
    process already runs is continued directly; otherwise it is loaded with
    thread/resume first.

    When ``message`` is given and the thread still has a running turn, the goal
    is paused, the runner waits for that turn to finish (ACTIVE_TURN_DRAIN_SECONDS)
    and then sends the message; on timeout it raises RuntimeError rather than
    drop the message.

    Returns (terminal_status, last_turn_error).
    """
    explicit_message = message is not None
    if message is None:
        message = default_resume_message(prompt_copy)
    input_items, _missing = input_items_for_resume(repo, message, objective)
    telemetry_input(args, input_items)
    loaded = getattr(client, "loaded_threads", None)
    already_loaded = isinstance(loaded, set) and thread_id in loaded
    with output_log.open("w", encoding="utf-8") as log:
        state = StageState(thread_id=thread_id, objective=objective, ignore_stale_goal_objective=True)
        if not already_loaded:
            resumed = client.request("thread/resume", thread_resume_params(args, repo, thread_id), log)
            if isinstance(loaded, set):
                loaded.add(thread_id)
            state.active_turns.update(in_progress_turn_ids(resumed))
        else:
            state.active_turns.update(LIVE_ACTIVE_TURNS.get(thread_id, ()))
        state.seen_turns.update(state.active_turns)
        if state.active_turns and not explicit_message:
            active = client.request(
                "thread/goal/set",
                {"threadId": thread_id, "objective": objective, "status": "active"},
                log,
                lambda msg: update_stage_state(state, msg),
            )
            active_goal = goal_from_response(active)
            if active_goal.get("objective") != objective or active_goal.get("status") != "active":
                raise RuntimeError(f"active resumed goal was not set exactly: {active_goal!r}")
            state.status = "active"
            state.terminal_status = None
            terminal = wait_for_stage_terminal(client, log, state)
            remember_active_turns(state)
            return terminal, state.last_turn_error

        paused = client.request(
            "thread/goal/set",
            {"threadId": thread_id, "objective": objective, "status": "paused"},
            log,
            lambda msg: update_stage_state(state, msg),
        )
        paused_goal = goal_from_response(paused)
        if paused_goal.get("objective") != objective or paused_goal.get("status") != "paused":
            raise RuntimeError(f"paused resumed goal was not set exactly: {paused_goal!r}")
        state.status = "paused"
        state.terminal_status = None
        if state.active_turns:
            print(
                f"WARNING: thread {thread_id} has a running turn; waiting up to "
                f"{ACTIVE_TURN_DRAIN_SECONDS:.0f}s for it to finish before sending the message",
                file=sys.stderr,
            )
            drain_active_turns(client, log, state, ACTIVE_TURN_DRAIN_SECONDS)
            state.status = "paused"

        turn_payload = turn_params(args, repo)
        turn_payload["input"] = input_items
        turn_payload["threadId"] = thread_id
        turn_started = client.request(
            "turn/start",
            turn_payload,
            log,
            lambda msg: update_stage_state(state, msg),
        )
        turn = turn_started.get("turn")
        if isinstance(turn, dict) and isinstance(turn.get("id"), str):
            turn_id = turn["id"]
            state.seen_turns.add(turn_id)
            if turn.get("status") == "inProgress":
                state.active_turns.add(turn_id)
            wait_for_turn_started(client, log, state, turn_id)

        active = client.request(
            "thread/goal/set",
            {"threadId": thread_id, "objective": objective, "status": "active"},
            log,
            lambda msg: update_stage_state(state, msg),
        )
        active_goal = goal_from_response(active)
        if active_goal.get("objective") != objective or active_goal.get("status") != "active":
            raise RuntimeError(f"active resumed goal was not set exactly: {active_goal!r}")
        state.status = "active"
        state.terminal_status = None

        terminal = wait_for_stage_terminal(client, log, state)
        remember_active_turns(state)
        return terminal, state.last_turn_error


def default_resume_message(prompt_copy: pathlib.Path) -> str:
    return "\n".join(
        [
            "Continue this existing multigoal stage after the previous turn stopped before the stage was complete.",
            "",
            f"Original goal prompt copy: {prompt_copy}",
            "",
            "Keep working on the same goal and use the existing artifacts, logs, and code state.",
            "Do not restart from scratch unless the current artifacts require it.",
            "The multigoal runner will run this stage's check script after you mark the goal complete, then continue later stages.",
            "When the original goal is genuinely complete, mark the goal complete. If it is impossible to proceed, mark it blocked with the concrete blocker.",
        ]
    )


def steering_message(text: str, prompt_copy: pathlib.Path) -> str:
    """Owner steering text, sent verbatim, plus a one-line pointer to the goal."""
    return "\n".join(
        [
            text.strip(),
            "",
            f"(Owner message delivered by the multigoal runner. Original goal prompt copy: {prompt_copy}. "
            "Mark the goal complete when its requirements are met; the runner then runs the stage check.)",
        ]
    )


def recovery_message(kind: str, turn_error: str | None, prompt_copy: pathlib.Path) -> str:
    reason = {
        "transient": "a transient API error (not a problem with your work)",
        "usage": "an account usage limit that has now reset",
    }.get(kind, kind)
    lines = [
        f"The previous turn of this stage stopped because of {reason}.",
    ]
    if turn_error:
        lines.append(f"Error: {turn_error[:300]}")
    lines += [
        "",
        f"Original goal prompt copy: {prompt_copy}",
        "Continue the same goal from the current artifacts, logs and code state. A command or device job",
        "that was running when the turn stopped was probably killed: check its state, and rerun it if needed",
        "(reset the device first if it was mid-run). When the goal is genuinely complete, mark it complete.",
    ]
    return "\n".join(lines)


def find_check_script(prompt_path: pathlib.Path) -> pathlib.Path | None:
    candidate = prompt_path.with_name(prompt_path.stem + ".check.sh")
    return candidate if candidate.exists() else None


def requires_model_dir(args: argparse.Namespace) -> bool:
    if args.no_checks:
        return False
    return any(find_check_script(prompt_path) is not None for prompt_path in args.prompt_files)


def resolve_model_dir_for_launch(
    *,
    replacements: list[tuple[str, str]],
    manifest_values: dict[str, str],
    required: bool,
) -> str | None:
    replacement_model_dir = replacement_value(replacements, "MODEL_DIR")
    manifest_model_dir = manifest_values.get("model_dir") or None
    if replacement_model_dir and manifest_model_dir and replacement_model_dir != manifest_model_dir:
        raise SystemExit(
            "MODEL_DIR replacement does not match existing manifest model_dir:\n"
            f"  --replace MODEL_DIR={replacement_model_dir}\n"
            f"  manifest model_dir={manifest_model_dir}"
        )
    model_dir = replacement_model_dir or manifest_model_dir
    if required and not model_dir:
        raise SystemExit(
            "MODEL_DIR is required when launching prompts with runner-side check scripts. "
            "Pass --replace MODEL_DIR=models/autoports/<model_dir> so stage gates are "
            "scoped to the exact autoport directory instead of relying on HF_MODEL fuzzy matching."
        )
    return model_dir


def replacement_env(replacements: list[tuple[str, str]]) -> dict[str, str]:
    return {old: new for old, new in replacements if ENV_NAME_RE.match(old)}


def run_check_script(
    script: pathlib.Path,
    repo: pathlib.Path,
    extra_env: dict[str, str],
    check_log: pathlib.Path,
) -> int:
    env = os.environ.copy()
    env.update(extra_env)
    result = subprocess.run(
        ["bash", str(script)],
        cwd=repo,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    check_log.write_text(result.stdout or "", encoding="utf-8")
    tail = "\n".join((result.stdout or "").splitlines()[-15:])
    print(f"check {script.name} exited {result.returncode}; log: {check_log}", file=sys.stderr)
    if tail:
        print(tail, file=sys.stderr)
    return result.returncode


def remediation_objective(
    prompt: str,
    *,
    script: pathlib.Path,
    check_log: pathlib.Path,
    prompt_copy: pathlib.Path,
    exit_code: int,
) -> str:
    first_line = objective_from_prompt(prompt).splitlines()[0].strip()
    severity = "CRITICAL" if exit_code >= CHECK_CRITICAL else "ADVISORY"
    objective = "\n".join(
        [
            first_line,
            "",
            "Runner-side verification: an independent check script ran after this goal "
            f"was previously reported complete and FAILED (exit {exit_code}, {severity}).",
            f"Check script: {script}",
            f"Full check output: {check_log}",
            f"Original goal requirements: {prompt_copy}",
            "Read the check output and treat it as a bug report against the previous "
            "completion claim. Reproduce the problem, fix the underlying cause, and "
            "re-verify by running the check script yourself until it exits 0 - or refute "
            "it with concrete evidence recorded in the stage work_log. All original "
            "completion requirements still apply.",
        ]
    )
    if len(objective) > MAX_GOAL_OBJECTIVE_CHARS:
        raise RuntimeError(f"remediation objective is {len(objective)} characters")
    return objective


def append_status(log_dir: pathlib.Path, name: str, goal_status: str, check_status: str, telemetry=None) -> None:
    status = log_dir / "STATUS.md"
    if not status.exists():
        status.write_text("| stage | goal | check |\n|---|---|---|\n", encoding="utf-8")
    with status.open("a", encoding="utf-8") as f:
        f.write(f"| {name} | {goal_status} | {check_status} |\n")
    if telemetry is not None:
        telemetry.safe_hook("stage_result", goal_status, check_status)


# ---------------------------------------------------------------------------
# Notifications

_NOTIFY_THREADS: list[threading.Thread] = []


def notify(args: argparse.Namespace, stage: str, status: str, log_dir: pathlib.Path, message: str) -> threading.Thread | None:
    """Run --notify-cmd in the background with STAGE/STATUS/LOG_DIR/MESSAGE set.

    Fire and forget: failures and timeouts are reported on stderr and never
    change the run's outcome.
    """
    command = getattr(args, "notify_cmd", None)
    if not command:
        return None
    timeout = getattr(args, "notify_timeout", 60)
    env = os.environ.copy()
    env.update(STAGE=stage, STATUS=status, LOG_DIR=str(log_dir), MESSAGE=message[:4000])

    def run() -> None:
        try:
            subprocess.run(
                command,
                shell=True,
                env=env,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=timeout,
            )
        except subprocess.TimeoutExpired:
            print(f"notify command timed out after {timeout}s", file=sys.stderr)
        except Exception as exc:  # noqa: BLE001 - notification must never fail the run
            print(f"notify command failed: {exc}", file=sys.stderr)

    thread = threading.Thread(target=run, daemon=True)
    thread.start()
    _NOTIFY_THREADS.append(thread)
    return thread


def flush_notifications(timeout: float = 10.0) -> None:
    """Give pending notify commands a moment to run before the runner exits."""
    deadline = time.monotonic() + timeout
    for thread in list(_NOTIFY_THREADS):
        thread.join(max(0.0, deadline - time.monotonic()))


# ---------------------------------------------------------------------------
# Stop classification, rate limits and automatic recovery


def parse_turn_error(turn_error: str | None) -> JsonObject:
    if not turn_error:
        return {}
    try:
        value = json.loads(turn_error)
    except (TypeError, json.JSONDecodeError):
        return {"message": str(turn_error)}
    if isinstance(value, dict):
        return value
    return {"message": str(value)}


def _normalized_code(value: str) -> str:
    return re.sub(r"[^a-z]", "", value.lower())


def error_details(turn_error: str | None) -> tuple[set[str], str, int | None]:
    """Return (normalized codexErrorInfo codes, message text, HTTP status)."""
    error = parse_turn_error(turn_error)
    codes: set[str] = set()
    http_status: int | None = None
    info = error.get("codexErrorInfo", error.get("codex_error_info"))
    if isinstance(info, str):
        codes.add(_normalized_code(info))
    elif isinstance(info, dict):
        for key, detail in info.items():
            codes.add(_normalized_code(str(key)))
            if isinstance(detail, dict) and isinstance(detail.get("httpStatusCode"), int):
                http_status = detail["httpStatusCode"]
    parts = [error.get("message"), error.get("additionalDetails")]
    message = " ".join(str(part) for part in parts if part)
    return codes, message, http_status


def classify_stop(terminal: str, turn_error: str | None) -> str:
    """Classify a stage stop as complete, usage, transient or other."""
    if terminal == "complete":
        return "complete"
    codes, message, http_status = error_details(turn_error)
    if terminal in USAGE_GOAL_STATUSES or codes & USAGE_ERROR_CODES or USAGE_MESSAGE_RE.search(message):
        return "usage"
    if codes & TRANSIENT_ERROR_CODES:
        return "transient"
    if http_status is not None and http_status >= 500:
        return "transient"
    if message and TRANSIENT_MESSAGE_RE.search(message):
        return "transient"
    return "other"


def read_rate_limits(client: Any, log_dir: pathlib.Path, *, fresh_only: bool = False) -> JsonObject | None:
    """Best-effort account rate-limit snapshot; None when unavailable.

    With ``fresh_only`` the last pushed (possibly stale) snapshot is not used
    when the read fails.
    """
    snapshot: JsonObject | None = None
    try:
        with (log_dir / "rate-limits.jsonl").open("a", encoding="utf-8") as log:
            result = client.request("account/rateLimits/read", None, log, timeout=RATE_LIMIT_READ_TIMEOUT)
        if isinstance(result.get("rateLimits"), dict):
            snapshot = result["rateLimits"]
    except Exception as exc:  # noqa: BLE001 - optional API; degrade gracefully
        print(f"rate limits unavailable: {str(exc)[:200]}", file=sys.stderr)
    if snapshot is None and not fresh_only:
        latest = getattr(client, "latest_rate_limits", None)
        snapshot = latest if isinstance(latest, dict) else None
    return snapshot


def rate_limit_windows(
    snapshot: JsonObject | None, keys: tuple[str, ...] = ("primary", "secondary")
) -> list[tuple[float, float | None]]:
    """(usedPercent, resetsAt epoch seconds) for each reported window."""
    windows: list[tuple[float, float | None]] = []
    if not isinstance(snapshot, dict):
        return windows
    for key in keys:
        window = snapshot.get(key)
        if not isinstance(window, dict):
            continue
        used = window.get("usedPercent")
        if not isinstance(used, (int, float)):
            continue
        reset = window.get("resetsAt")
        windows.append((float(used), float(reset) if isinstance(reset, (int, float)) else None))
    return windows


def has_spendable_credits(snapshot: JsonObject | None) -> bool:
    credits = snapshot.get("credits") if isinstance(snapshot, dict) else None
    if not isinstance(credits, dict):
        return False
    if credits.get("unlimited"):
        return True
    try:
        return bool(credits.get("hasCredits")) and float(credits.get("balance") or 0) > 0
    except (TypeError, ValueError):
        return False


def reset_from_message(message: str) -> float | None:
    """Parse "try again at Oct 22nd, 2026 6:14 AM" (local time) to epoch seconds."""
    match = TRY_AGAIN_RE.search(message or "")
    if not match:
        return None
    month, day, year, clock, meridiem = match.groups()
    try:
        moment = dt.datetime.strptime(f"{month.title()} {day} {year} {clock} {meridiem.upper()}", "%b %d %Y %I:%M %p")
    except ValueError:
        return None
    return moment.timestamp()


def usage_reset_epoch(snapshot: JsonObject | None, turn_error: str | None) -> float | None:
    now = time.time()
    exhausted = [reset for used, reset in rate_limit_windows(snapshot) if used >= 100 and reset and reset > now]
    if exhausted:
        return max(exhausted)
    _codes, message, _status = error_details(turn_error)
    return reset_from_message(message)


def format_epoch(epoch: float) -> str:
    return dt.datetime.fromtimestamp(epoch, dt.timezone.utc).strftime("%Y-%m-%dT%H:%MZ")


def claim_usage_wait(args: argparse.Namespace, seconds: float) -> bool:
    """Charge a wait against --max-usage-wait-hours; False when it would exceed it."""
    waited = getattr(args, "_usage_waited", 0.0)
    limit = getattr(args, "max_usage_wait_hours", 168.0) * 3600
    if waited + seconds > limit:
        return False
    args._usage_waited = waited + seconds
    return True


def wait_for_headroom(client: Any, args: argparse.Namespace, log_dir: pathlib.Path, name: str) -> None:
    """Pause once before a stage while a rate-limit window has less than --min-headroom-pct left.

    Only a fresh account/rateLimits/read counts; a failed read never pauses.
    Only windows that reset in the future count. The primary (short) window is
    checked; the secondary (weekly) one only with --wait-on-usage-limit. One
    pause lasts at most HEADROOM_MAX_PAUSE_SECONDS; the stage starts afterwards.
    """
    minimum = getattr(args, "min_headroom_pct", 0.0)
    if minimum <= 0:
        return
    snapshot = read_rate_limits(client, log_dir, fresh_only=True)
    if snapshot is None:
        print(f"headroom check skipped: no fresh rate-limit read; starting {name}", file=sys.stderr)
        return
    if has_spendable_credits(snapshot):
        return
    keys = ("primary", "secondary") if getattr(args, "wait_on_usage_limit", False) else ("primary",)
    now = time.time()
    low = []
    for key in keys:
        for used, reset in rate_limit_windows(snapshot, (key,)):
            if reset and reset > now and 100 - used < minimum:
                low.append((reset, key, used))
    if not low:
        return
    reset, key, used = max(low)
    wanted = max(60.0, reset - now + 120)
    delay = min(wanted, HEADROOM_MAX_PAUSE_SECONDS)
    if not claim_usage_wait(args, delay):
        print(f"rate-limit headroom low but usage wait budget is spent; starting {name}", file=sys.stderr)
        return
    capped = f" (capped at {HEADROOM_MAX_PAUSE_SECONDS / 3600:g} h; the stage starts afterwards)" if delay < wanted else ""
    note = (
        f"paused before start: {key} rate-limit window has {100 - used:.0f}% headroom < {minimum:g}% "
        f"(resets {format_epoch(reset)}); pausing {delay / 3600:.1f} h{capped}"
    )
    append_status(log_dir, name, "not-started", note)
    print(note, file=sys.stderr)
    notify(args, name, "headroom-wait", log_dir, note)
    _sleep(delay)
    print(f"headroom pause over; starting {name}", file=sys.stderr)


def recover_stop(
    client: Any,
    args: argparse.Namespace,
    repo: pathlib.Path,
    log_dir: pathlib.Path,
    manifest: pathlib.Path,
    *,
    name: str,
    key_prefix: str,
    objective: str,
    thread_id: str | None,
    prompt_copy: pathlib.Path,
    terminal: str,
    turn_error: str | None,
) -> tuple[str, str | None]:
    """Resume the same thread after transient API errors and (opt-in) usage limits.

    Returns the final (terminal_status, last_turn_error). A genuine agent
    blocker ("other") is returned unchanged.
    """
    transient_used = 0
    unknown_reset_used = 0
    attempt = 0
    while thread_id:
        kind = classify_stop(terminal, turn_error)
        if kind == "transient":
            retries = getattr(args, "transient_retries", 0)
            if transient_used >= retries:
                append_status(log_dir, name, terminal, f"transient error: {retries} automatic resume(s) used")
                break
            delays = getattr(args, "transient_backoff_seconds", [300])
            delay = float(delays[min(transient_used, len(delays) - 1)])
            transient_used += 1
            note = f"transient API error; resume {transient_used}/{retries} in {delay:.0f}s"
        elif kind == "usage" and terminal == "budgetLimited":
            # The goal's own token budget, not an account limit: waiting does not help.
            append_status(
                log_dir, name, terminal,
                "goal token budget exhausted (budgetLimited); not waitable. Raise the budget and "
                "resume with --resume-stage and the same --log-dir",
            )
            break
        elif kind == "usage":
            reset = usage_reset_epoch(read_rate_limits(client, log_dir), turn_error)
            when = format_epoch(reset) if reset else "unknown"
            if not getattr(args, "wait_on_usage_limit", False):
                note = (
                    f"usage limit; resets {when}. Resume with --resume-stage and the same --log-dir, "
                    "or run with --wait-on-usage-limit"
                )
                append_status(log_dir, name, terminal, note)
                break
            if reset:
                delay = max(60.0, reset - time.time() + 120)
            else:
                if unknown_reset_used >= MAX_UNKNOWN_RESET_RESUMES:
                    append_status(
                        log_dir, name, terminal,
                        f"usage limit with no known reset time; {MAX_UNKNOWN_RESET_RESUMES} polling resume(s) used",
                    )
                    break
                unknown_reset_used += 1
                delay = float(getattr(args, "usage_poll_seconds", 1800))
            if not claim_usage_wait(args, delay):
                append_status(log_dir, name, terminal, f"usage limit; resets {when}; wait budget exhausted")
                break
            note = f"usage limit; waiting until {when if reset else format_epoch(time.time() + delay)} then resuming"
            notify(args, name, "usage-wait", log_dir, note)
        else:
            break
        append_status(log_dir, name, terminal, note)
        print(note, file=sys.stderr)
        _sleep(delay)
        attempt += 1
        output_log = log_dir / f"{name}.auto-resume-{attempt}.jsonl"
        append_manifest(
            manifest,
            [
                f"{key_prefix}_auto_resume_{attempt}_reason={kind}",
                f"{key_prefix}_auto_resume_{attempt}_started_at_utc={timestamp()}",
            ],
        )
        print(f"\n== Auto-resume {attempt} ({kind}): {name} ==\n+ log: {output_log}", file=sys.stderr)
        terminal, turn_error = execute_resumed_goal(
            client,
            args,
            repo,
            objective,
            thread_id,
            output_log,
            prompt_copy,
            message=recovery_message(kind, turn_error, prompt_copy),
        )
        append_manifest(manifest, [f"{key_prefix}_auto_resume_{attempt}_terminal_status={terminal}"])
    return terminal, turn_error


def run_stage_checks(
    client: AppServerClient,
    args: argparse.Namespace,
    repo: pathlib.Path,
    log_dir: pathlib.Path,
    manifest: pathlib.Path,
    index: int,
    name: str,
    prompt: str,
    prompt_path: pathlib.Path,
    prompt_copy: pathlib.Path,
    replacements: list[tuple[str, str]],
    manifest_key_prefix: str | None = None,
    thread_id: str | None = None,
) -> str:
    """Run the stage's check script with remediation. Returns the check status string.

    Exit 1 (advisory) is recorded without remediation unless
    --remediate-advisory is set. Remediation runs in a new thread by default; with
    --remediation-thread same and a known stage thread it is the next turn of that
    thread, falling back to a new thread when that thread cannot take the turn.
    """
    manifest_key_prefix = manifest_key_prefix or f"stage_{index}"
    script = find_check_script(prompt_path)
    if script is None or args.no_checks:
        status = "skipped" if args.no_checks and script is not None else "none"
        append_manifest(manifest, [f"{manifest_key_prefix}_check={status}"])
        return status

    extra_env = replacement_env(replacements)
    extra_env["MULTIGOAL_LOG_DIR"] = str(log_dir)
    extra_env["MULTIGOAL_STAGE"] = name
    remediate_advisory = getattr(args, "remediate_advisory", False)
    same_thread = getattr(args, "remediation_thread", "new") == "same" and thread_id is not None

    code = -1
    for attempt in range(args.check_retries + 1):
        check_log = log_dir / f"{name}.check-{attempt + 1}.log"
        code = run_check_script(script, repo, extra_env, check_log)
        if getattr(args, "_telemetry", None) is not None:
            args._telemetry.safe_hook("check", code, False)
        append_manifest(manifest, [f"{manifest_key_prefix}_check_attempt_{attempt + 1}=exit{code}"])
        if code not in (CHECK_PASS, CHECK_ADVISORY, CHECK_CRITICAL):
            # Broken check or environment: retry once for transients.
            check_log = log_dir / f"{name}.check-{attempt + 1}-retry.log"
            code = run_check_script(script, repo, extra_env, check_log)
            if getattr(args, "_telemetry", None) is not None:
                args._telemetry.safe_hook("check", code, True)
            append_manifest(manifest, [f"{manifest_key_prefix}_check_attempt_{attempt + 1}_retry=exit{code}"])
        if code == CHECK_PASS:
            append_manifest(manifest, [f"{manifest_key_prefix}_check=pass"])
            return "pass"
        if code not in (CHECK_ADVISORY, CHECK_CRITICAL):
            append_manifest(manifest, [f"{manifest_key_prefix}_check=check-error(exit{code})"])
            return f"check-error(exit{code})"
        if code == CHECK_ADVISORY and not remediate_advisory:
            print("advisory check findings recorded; no remediation (--remediate-advisory to enable)", file=sys.stderr)
            break
        if attempt >= args.check_retries:
            break
        objective = remediation_objective(
            prompt,
            script=script,
            check_log=check_log,
            prompt_copy=prompt_copy,
            exit_code=code,
        )
        key = f"{manifest_key_prefix}_remediation_{attempt + 1}"
        remediation_log = log_dir / f"{name}.remediation-{attempt + 1}.jsonl"
        mode = "same" if same_thread else "new"
        print(f"\n== Stage {index} remediation {attempt + 1} ({mode} thread): check failed (exit {code}) ==", file=sys.stderr)
        print(f"+ log: {remediation_log}", file=sys.stderr)
        append_manifest(manifest, [f"{key}_thread_mode={mode}"])
        fallback = False
        if same_thread:
            assert thread_id is not None
            append_manifest(manifest, [f"{key}_thread_id={thread_id}"])
            stage_objective = objective_from_prompt(prompt)
            try:
                terminal, turn_error = execute_resumed_goal(
                    client,
                    args,
                    repo,
                    stage_objective,
                    thread_id,
                    remediation_log,
                    prompt_copy,
                    attempt_kind="remediation",
                    message=objective,
                )
                remediation_thread: str | None = thread_id
            except RuntimeError as exc:
                print(f"same-thread remediation failed ({str(exc)[:300]}); falling back to a new thread", file=sys.stderr)
                append_manifest(manifest, [f"{key}_thread_mode=new(fallback)"])
                remediation_log = log_dir / f"{name}.remediation-{attempt + 1}-new.jsonl"
                fallback = True
        if not same_thread or fallback:
            stage_objective = objective
            terminal, remediation_thread, turn_error = execute_goal(
                client,
                args,
                repo,
                objective,
                remediation_log,
                attempt_kind="remediation",
                on_thread_started=lambda tid: append_manifest(manifest, [f"{key}_thread_id={tid}"]),
            )
        terminal, turn_error = recover_stop(
            client,
            args,
            repo,
            log_dir,
            manifest,
            name=f"{name}.remediation-{attempt + 1}",
            key_prefix=key,
            objective=stage_objective,
            thread_id=remediation_thread,
            prompt_copy=prompt_copy,
            terminal=terminal,
            turn_error=turn_error,
        )
        append_manifest(manifest, [f"{key}_terminal_status={terminal}"])
        if terminal != "complete":
            detail = f": {turn_error}" if turn_error else ""
            print(f"remediation goal ended {terminal}{detail}", file=sys.stderr)
            break

    status = "critical-fail" if code >= CHECK_CRITICAL else "advisory-fail"
    append_manifest(manifest, [f"{manifest_key_prefix}_check={status}"])
    return status


def finish_stage(
    client: AppServerClient,
    args: argparse.Namespace,
    repo: pathlib.Path,
    log_dir: pathlib.Path,
    manifest: pathlib.Path,
    *,
    index: int,
    name: str,
    label: str,
    key_prefix: str,
    prompt: str,
    prompt_path: pathlib.Path,
    prompt_copy: pathlib.Path,
    replacements: list[tuple[str, str]],
    objective: str,
    thread_id: str | None,
    terminal: str,
    turn_error: str | None,
) -> int:
    """Recover, check and report one stage goal after its first terminal status."""
    first_terminal = terminal
    terminal, turn_error = recover_stop(
        client,
        args,
        repo,
        log_dir,
        manifest,
        name=name,
        key_prefix=key_prefix,
        objective=objective,
        thread_id=thread_id,
        prompt_copy=prompt_copy,
        terminal=terminal,
        turn_error=turn_error,
    )
    if terminal != first_terminal:
        append_manifest(manifest, [f"{key_prefix}_terminal_status={terminal}"])
    telemetry = getattr(args, "_telemetry", None)
    if terminal == "turnFailed":
        append_status(log_dir, name, terminal, "not-run", telemetry)
        message = f"Stopping after {label} {index}: turn failed: {turn_error}"
        print(message, file=sys.stderr)
        notify(args, name, terminal, log_dir, message)
        return 5
    if terminal != "complete":
        append_status(log_dir, name, terminal, "not-run", telemetry)
        message = f"Stopping after {label} {index}: goal is {terminal}"
        if turn_error:
            message += f" ({turn_error[:300]})"
        print(message, file=sys.stderr)
        notify(args, name, terminal, log_dir, message)
        return 3

    check_status = run_stage_checks(
        client,
        args,
        repo,
        log_dir,
        manifest,
        index,
        name,
        prompt,
        prompt_path,
        prompt_copy,
        replacements,
        manifest_key_prefix=key_prefix,
        thread_id=thread_id,
    )
    append_status(log_dir, name, terminal, check_status, telemetry)
    if check_status == "critical-fail":
        message = (
            f"Stopping after {label} {index}: verification failed critically after "
            f"{args.check_retries} remediation attempt(s). Artifacts are preserved; "
            "later stages would build on a broken base."
        )
        print(message, file=sys.stderr)
        notify(args, name, check_status, log_dir, message)
        return 6
    if check_status.startswith("check-error"):
        message = (
            f"{label} {index}: the verification check itself failed ({check_status}). "
            "This is a runner/environment fault, not a model verdict."
        )
        notify(args, name, check_status, log_dir, message)
        if args.check_error_policy == "stop":
            print(
                f"Stopping after {message} Fix the check or environment, then resume with "
                f"--start-index {index} (the stage goal already completed, so rerun "
                "from this stage only if its work needs re-verification).",
                file=sys.stderr,
            )
            return 7
    return 0


def run_stage(
    client: AppServerClient,
    args: argparse.Namespace,
    repo: pathlib.Path,
    log_dir: pathlib.Path,
    manifest: pathlib.Path,
    index: int,
    prompt_path: pathlib.Path,
    replacements: list[tuple[str, str]],
) -> int:
    prompt = load_prompt(prompt_path, replacements)
    objective = objective_from_prompt(prompt)
    name = stage_name(index, prompt_path)
    prompt_copy = log_dir / f"{name}.prompt.txt"
    prompt_copy.write_text(prompt)
    output_log = log_dir / f"{name}.jsonl"
    _input_items, missing_skills = input_items_for_objective(repo, objective)

    print(f"\n== Stage {index}: {prompt_path} ==", file=sys.stderr)
    print(f"+ log: {output_log}", file=sys.stderr)
    print(f"+ objective_chars: {len(objective)}", file=sys.stderr)
    if missing_skills:
        print(f"+ missing skill paths: {', '.join(missing_skills)}", file=sys.stderr)

    if args.dry_run:
        output_log.write_text(objective)
        check_script = find_check_script(prompt_path)
        append_manifest(
            manifest,
            [
                f"stage_{index}_dry_run=true",
                f"stage_{index}_objective_chars={len(objective)}",
                f"stage_{index}_skills={','.join(parse_skill_names(objective))}",
                f"stage_{index}_check_script={check_script if check_script else 'none'}",
            ],
        )
        return 0

    append_manifest(
        manifest,
        [
            f"stage_{index}_objective_chars={len(objective)}",
            f"stage_{index}_skills={','.join(parse_skill_names(objective))}",
            f"stage_{index}_missing_skills={','.join(missing_skills)}",
        ],
    )

    terminal, thread_id, turn_error = execute_goal(
        client,
        args,
        repo,
        objective,
        output_log,
        on_thread_started=lambda tid: append_manifest(manifest, [f"stage_{index}_thread_id={tid}"]),
    )
    append_manifest(manifest, [f"stage_{index}_terminal_status={terminal}"])
    print(f"stage_terminal_status={terminal}", file=sys.stderr)
    return finish_stage(
        client,
        args,
        repo,
        log_dir,
        manifest,
        index=index,
        name=name,
        label="stage",
        key_prefix=f"stage_{index}",
        prompt=prompt,
        prompt_path=prompt_path,
        prompt_copy=prompt_copy,
        replacements=replacements,
        objective=objective,
        thread_id=thread_id,
        terminal=terminal,
        turn_error=turn_error,
    )


def run_resumed_stage(
    client: AppServerClient,
    args: argparse.Namespace,
    repo: pathlib.Path,
    log_dir: pathlib.Path,
    manifest: pathlib.Path,
    index: int,
    prompt_path: pathlib.Path,
    replacements: list[tuple[str, str]],
    manifest_values: dict[str, str],
) -> int:
    prompt = load_prompt(prompt_path, replacements)
    objective = objective_from_prompt(prompt)
    name = stage_name(index, prompt_path)
    prompt_copy = log_dir / f"{name}.prompt.txt"
    if not prompt_copy.exists():
        prompt_copy.write_text(prompt, encoding="utf-8")
    thread_id = manifest_values.get(f"stage_{index}_thread_id")
    if not thread_id:
        raise RuntimeError(f"cannot resume stage {index}: manifest has no stage_{index}_thread_id")
    attempt = next_resume_attempt(manifest_values, index)
    resume_name = f"{name}.resume-{attempt}"
    output_log = log_dir / f"{resume_name}.jsonl"

    message: str | None = None
    manifest_lines = [
        f"stage_{index}_resume_{attempt}_started_at_utc={timestamp()}",
        f"stage_{index}_resume_{attempt}_thread_id={thread_id}",
    ]
    message_file = getattr(args, "message_file", None)
    if message_file is not None:
        text = message_file.read_text(encoding="utf-8")
        copy = log_dir / f"{resume_name}.message.txt"
        copy.write_text(text, encoding="utf-8")
        message = steering_message(text, prompt_copy)
        manifest_lines.append(f"stage_{index}_resume_{attempt}_message_file={copy}")

    print(f"\n== Resume stage {index}: {prompt_path} ==", file=sys.stderr)
    print(f"+ thread: {thread_id}", file=sys.stderr)
    print(f"+ log: {output_log}", file=sys.stderr)
    if message is not None:
        print(f"+ message: {message_file}", file=sys.stderr)
    append_manifest(manifest, manifest_lines)

    terminal, turn_error = execute_resumed_goal(
        client,
        args,
        repo,
        objective,
        thread_id,
        output_log,
        prompt_copy,
        message=message,
    )
    append_manifest(manifest, [f"stage_{index}_resume_{attempt}_terminal_status={terminal}"])
    print(f"stage_resume_terminal_status={terminal}", file=sys.stderr)
    return finish_stage(
        client,
        args,
        repo,
        log_dir,
        manifest,
        index=index,
        name=resume_name,
        label="resumed stage",
        key_prefix=f"stage_{index}_resume_{attempt}",
        prompt=prompt,
        prompt_path=prompt_path,
        prompt_copy=prompt_copy,
        replacements=replacements,
        objective=objective,
        thread_id=thread_id,
        terminal=terminal,
        turn_error=turn_error,
    )


def main() -> int:
    args = parse_args()
    repo = args.repo.expanduser().resolve()
    env = os.environ.copy()
    env.update(environment(dependency_root(), env))
    home = codex_home(env, args.codex_home)
    default_log_root = pathlib.Path(
        os.environ.get(
            "RUN_MULTIGOAL_LOG_DIR",
            repo / "bringup" / "artifacts" / "multigoal-runs",
        )
    )
    log_dir = args.log_dir or default_log_root / timestamp()
    log_dir.mkdir(parents=True, exist_ok=True)
    replacements = parse_replacements(args.replace)
    manifest = log_dir / "manifest.txt"
    if manifest.exists() and args.resume_stage is None and any(
        key.endswith("_thread_id") for key in read_manifest(manifest)
    ):
        raise SystemExit("This log directory contains a live run. Use --resume-stage or a new --log-dir.")
    if args.resume_stage is not None and not manifest.exists():
        raise SystemExit(f"--resume-stage requires an existing manifest: {manifest}")
    manifest_values = read_manifest(manifest) if args.resume_stage is not None else {}
    model_dir = resolve_model_dir_for_launch(
        replacements=replacements,
        manifest_values=manifest_values,
        required=requires_model_dir(args),
    )
    if model_dir and replacement_value(replacements, "MODEL_DIR") is None:
        replacements.append(("MODEL_DIR", model_dir))
    codex_bin = (args.codex_bin or "codex") if args.dry_run else resolve_codex_bin(args.codex_bin)
    if args.resume_stage is None:
        write_manifest_header(manifest, repo, home, codex_bin, args, replacements, model_dir)
    elif model_dir and not manifest_values.get("model_dir"):
        append_manifest(manifest, [f"model_dir={model_dir}"])

    # Validate every prompt up front so an over-long or malformed late-stage
    # prompt cannot kill a run hours in.
    for prompt_path in args.prompt_files:
        objective = objective_from_prompt(load_prompt(prompt_path, replacements))
        _, missing = input_items_for_objective(repo, objective)
        if missing:
            raise SystemExit("Missing packaged skills: " + ", ".join(missing))

    args._telemetry = load_telemetry(
        args.telemetry_plugin, log_dir=log_dir, repo=repo, args=args, env=env,
        codex_bin=codex_bin, hf_model=replacement_value(replacements, "HF_MODEL"),
    )

    if args.dry_run:
        client: AppServerClient | None = None
        for index, prompt_path in enumerate(args.prompt_files, start=args.start_index):
            if args.resume_stage is not None and index < args.resume_stage:
                continue
            code = run_stage(
                client,  # type: ignore[arg-type]
                args,
                repo,
                log_dir,
                manifest,
                index,
                prompt_path,
                replacements,
            )
            if code != 0:
                return code
        return 0

    telemetry = args._telemetry
    stderr_log = log_dir / "app-server.stderr.log"
    run_status = "interrupted"
    try:
        if telemetry is not None:
            telemetry.safe_hook("start")
            telemetry.safe_hook("bootstrap")
        with AppServerClient(codex_bin, repo, env, stderr_log, args.config) as client:
            with (log_dir / "initialize.jsonl").open("w", encoding="utf-8") as init_log:
                client.request(
                    "initialize",
                    {
                        "clientInfo": {
                            "name": "tt-metal-multigoal",
                            "title": "TT Metal Multigoal Runner",
                            "version": "1",
                        },
                        "capabilities": {"experimentalApi": True},
                    },
                    init_log,
                )
                client._send({"method": "initialized"}, init_log)
                verify_enabled_installations(client.request(
                    "skills/list", {"cwds": [str(repo)], "forceReload": True}, init_log
                ))

            manifest_values = read_manifest(manifest)
            for index, prompt_path in enumerate(args.prompt_files, start=args.start_index):
                if args.resume_stage is not None and index < args.resume_stage:
                    continue
                wait_for_headroom(client, args, log_dir, stage_name(index, prompt_path))
                if telemetry is not None:
                    telemetry.safe_hook("begin_stage", index)
                if args.resume_stage is not None and index == args.resume_stage:
                    code = run_resumed_stage(
                        client,
                        args,
                        repo,
                        log_dir,
                        manifest,
                        index,
                        prompt_path,
                        replacements,
                        manifest_values,
                    )
                else:
                    code = run_stage(
                        client,
                        args,
                        repo,
                        log_dir,
                        manifest,
                        index,
                        prompt_path,
                        replacements,
                    )
                if telemetry is not None:
                    telemetry.safe_hook("end_stage")
                if code != 0:
                    run_status = "stopped"
                    return code

        run_status = "complete"
    except Exception as exc:
        notify(args, "run", "runner-error", log_dir, f"multigoal runner error: {str(exc)[:1000]}")
        raise
    finally:
        flush_notifications(min(10.0, float(getattr(args, "notify_timeout", 10))))
        if telemetry is not None:
            telemetry.safe_hook("end_stage", "interrupted")
            try:
                telemetry.safe_hook("finish", run_status)
            finally:
                telemetry.close()

    print(f"\nAll {len(args.prompt_files)} goals completed.", file=sys.stderr)
    print(f"Logs: {log_dir}", file=sys.stderr)
    notify(args, "run", "complete", log_dir, f"All {len(args.prompt_files)} goals completed. Logs: {log_dir}")
    flush_notifications(min(10.0, float(getattr(args, "notify_timeout", 10))))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
